# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Painel do Supabase → Project Settings → Data API
#
# A chave anon é pública por natureza: ela vai para o navegador de qualquer jeito.
# Quem protege os dados é o RLS do schema.sql, não o segredo da chave.
# Nunca coloque aqui a service_role.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
